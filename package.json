{
  "name": "@zcashlabs/zcash.js",
  "description": "Zcash JavaScript SDK with a bundled, lazily loaded wallet runtime and local proving assets.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zcashlabs/zcashjs.git"
  },
  "bugs": "https://github.com/zcashlabs/zcashjs/issues",
  "homepage": "https://github.com/zcashlabs/zcashjs#readme",
  "publishConfig": {
    "access": "public",
    "tag": "latest",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": "22.23.4"
  },
  "scripts": {
    "docs:dev": "vitepress dev docs --host 127.0.0.1 --port 4173 --strictPort",
    "docs:build": "vitepress build docs",
    "docs:preview": "vite preview --outDir docs/.vitepress/dist --host 127.0.0.1 --port 4173 --strictPort --base /",
    "docs:validate": "node scripts/check-docs-site.js",
    "docs:typecheck": "tsc -p docs/api/examples/tsconfig.json && node scripts/check-guide.js",
    "docs:check-recovery": "node docs/api/check-recovery-spec.js",
    "build": "node scripts/build.js",
    "prepack": "npm run build",
    "test:sdk": "npm run build && node --test tests/sdk/*.test.js",
    "test": "npm run build && node --test --test-concurrency=4 tests/*/*.test.js",
    "test:sdk:real-firefox": "node tests/sdk/real-firefox-run.js",
    "test:example:browser": "npm run build && node scripts/verify-bundled-browser.js --example",
    "test:package:browser": "npm run build && node scripts/verify-bundled-browser.js",
    "test:package:node": "npm run build && node scripts/verify-bundled-browser.js --node-only",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "check": "npm run lint && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "eslint": "^10.10.0",
    "rolldown": "1.2.7",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitepress": "2.0.0-alpha.20",
    "webpack": "5.110.3"
  },
  "version": "0.1.1",
  "type": "module",
  "files": [
    "dist/src",
    "CHANGELOG.md",
    "licenses"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./grpc-node": {
      "node": {
        "types": "./dist/src/clients/grpc-node.d.ts",
        "import": "./dist/src/clients/grpc-node.js"
      }
    }
  },
  "types": "./dist/src/index.d.ts",
  "sideEffects": false,
  "dependencies": {
    "@grpc/grpc-js": "1.14.4"
  },
  "license": "MIT"
}
